<% layout("/layouts/boilerplate") %>
<body>
  <br>
  
  <div class="row">
    <div class="col-8 offset-2">
      <h3>Listing details</h3>
      <div class="card show-card listing-card">
        <img src="<%=selectedListing.image.url%>" class="card-img-top show-card-img" alt="Listing Image">
        <div class="card-body">
          <h5 class="card-title"><%= selectedListing.title%></h5>
          <p class="card-text"> <%= selectedListing.description%> .</p>
        </div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item listing-price"> &#8377; <%= selectedListing.price.toLocaleString("en-IN")%></li>
          <li class="list-group-item listing-location"> <%= selectedListing.location%></li>
          <li class="list-group-item listing-country"> <%= selectedListing.country%></li>
        </ul>
        <p class="card-text ms-auto mt-2">Owned by:  <i><b><%= selectedListing.owner.username %></b></i></p>
        <%if(currUser){%>
          <% if(currUser._id.equals(selectedListing.owner._id)) {%>
        <div class="card-body">
          <a class="btn btn-dark" href="/listings/<%=selectedListing._id %>/edit">Edit Listing</a>
          <br><br>   
          <form method="post" action="/listings/<%=selectedListing._id%>?_method=DELETE">
            <button class="btn btn-dark">Delete this listing</button>
          </form>
        </div>
        <%}%>
        <%}%>
        

      </div> </div> <hr class="col-8 offset-2 my-4">
  <% if(currUser) {%>
      <div class="col-8 offset-2 mb-3">
      <h4>Leave a Review</h4>
      <form action="/listings/<%=selectedListing._id%>/reviews" method="post" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
        </div>
        <div class="mb-3 mt-3">
          <label class="form-label" for="comments">Comments</label>
          <textarea name="review[comment]" cols="30" rows="5" class="form-control" id="comments" required></textarea>
          <div class="invalid-feedback">Please add some comments for your review</div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
    </div>
  <%}%>
    

    <div class="col-8 offset-2">
      <p><b>All Reviews</b></p>
      <div class="row">
        <% for(review of selectedListing.reviews) { %>
          <div class="col-12 col-md-6 mb-3">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="card-title"><b>@ </b><%= review.writer.username %></h5>
                <h6 class="card-subtitle mb-2 text-body-secondary"><%= review.rating %> stars</h6>
                <p class="card-text"><%= review.comment %></p>
                <%if(currUser){%>
                  <% if(currUser._id.equals(review.writer._id)) {%>
                <form class="mb-3" method="POST" action="/listings/<%= selectedListing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-dark">Delete</button>
                </form>
              <%}%>
              </div>
            </div>
          </div>
        <% } %>
        <% } %>
      </div>
    </div>

  </div> </body>