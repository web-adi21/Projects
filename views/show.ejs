<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>
  <ul>
    <li>Title : <%= selectedListing.title%> </li>
    <li>description : <%= selectedListing.description%> </li>
    <li>Price : &#8377 <%= selectedListing.price.toLocaleString("en-IN")%> </li> 
    <li>Location : <%= selectedListing.location%> </li>
    <li>Country : <%= selectedListing.country%> </li>
  </ul>
  <button><a href="/listings/<%=selectedListing._id %>/edit">Edit Listing</a> </button>
  <form method="post" action="/listings/<%=selectedListing._id%>?_method=DELETE">
    <button>Delete this listing</button>
  </form>
</body>
</html>