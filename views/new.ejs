<% layout("/layouts/boilerplate") %>
<body>
  <h1> Create a New Lising</h1>
  <form method="post" action="/listings">
    <h3>Title : <input type="text" name="title" placeholder="Enter your listing's title here"></h3>
    <br><br>
    <h3>Description : <textarea type="text" name="description" placeholder="Enter your listing's title here"></textarea></h3>
    <br><br>
    <h3>Image : <input type="text" name="image" placeholder="Enter your listing's Image URL here"></h3>
    <br><br>
    <h3>Price : <input type="number" name="price" placeholder="Enter your listing's title here"></h3>
    <br><br>
    <h3>Location : <input type="text" name="location" placeholder="Enter your listing's title here"></h3>
    <br><br>
    <h3>Country : <input type="text" name="country" placeholder="Enter your listing's title here"></h3>
    <br><br>
    <button>Add</button>
  </form>
</body>
