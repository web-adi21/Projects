<% layout("/layouts/boilerplate") %> 
<style>
  #filter-container {
    display: flex;
    flex-wrap: wrap;
  }
  #filter {
    margin-top: 1rem;
    margin-right: 3rem;
    text-align: center;
    opacity: 0.7;
    
  }
  #filter:hover {
    opacity: 1;
    cursor: pointer;
  }
</style>
<body>
  <br>
  <!-- <h3>All Listings</h3> -->
  <!-- <form method="get" action="/listings/new">
    <button>Create New</button>
  </form> -->

  <div id="filter-container" class="mb-2">

    <div id="filter">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>

    <div id="filter">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </div>

    <div id="filter">
      <div><i class="fa-solid fa-archway"></i></div>
      <p>Iconic Cities</p>
    </div>

    <div id="filter">
      <div><i class="fa-solid fa-mountain-sun"></i></div>
      <p>Mountains</p>
    </div>

    <div id="filter">
      <div><i class="fa-brands fa-fort-awesome-alt"></i></div>
      <p>Castles</p>
    </div>

    <div id="filter">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing pools</p>
    </div>

    <div id="filter">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </div>

    <div id="filter">
      <div><i class="fa-solid fa-tractor"></i></div>
      <p>Farms</p>
    </div>

    <div id="filter">
      <div><i class="fa-solid fa-umbrella-beach"></i></div>
      <p>Beaches</p>
    </div>

    <div id="filter">
      <div><i class="fa-solid fa-snowman"></i></div>
      <p>Snowie Peaks</p>
    </div>

    
  </div>
  
<div class="row row-col-lg-3 row row-col-md-2 row row-col-sm-1">
   <% for(let i = 0; i<allListings.length;i++) {%>
    
  <div class="card index-card listing-card" style="width: 25rem;" >
  <a href="/listings/<%= allListings[i].id %>" class="card-anchor">
  <img src="<%= allListings[i].image.url %>" class="card-img-top listing-img" alt="listing_image" style="height: 20rem;">
  <div class="card-body">
    <h5 class="card-title"><%=allListings[i].title%><br><br>&#8377;<b><%=allListings[i].price.toLocaleString("en-IN")%></b></h5>
    
  <p class="card-text"><%=allListings[i].description%>.</p>
    
    
  </div>
  </a>
</div>

<% } %>
</div>

</body>
