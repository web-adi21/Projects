<% layout("/layouts/boilerplate") %>
<body>
  <script>
    const mapToken = "<%=process.env.MAP_TOKEN%>";
    const selectedListing = <%-JSON.stringify(selectedListing)%>;
    
  </script>
  <br>
  
  <div class="row">
    <div class="col-8 offset-2">
      <h3>Listing details</h3>
      <div class="card show-card listing-card"></div>
        <img src="<%=selectedListing.image.url%>" class="card-img-top show-card-img" alt="Listing Image">
        <div class="card-body">
          <h5 class="card-title"><%= selectedListing.title%></h5>
          <p class="card-text"><%= selectedListing.description%></p>
        </div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item listing-price"> &#8377; <%= selectedListing.price.toLocaleString("en-IN")%></li>
          <li class="list-group-item listing-location"> <%= selectedListing.location%></li>
          <li class="list-group-item listing-country"> <%= selectedListing.country%></li>
        </ul>
        <p class="card-text ms-auto mt-2">Owned by:  <i><b><%= selectedListing.owner.username %></b></i></p>
        <%if(currUser){%>
          <% if(currUser._id.equals(selectedListing.owner._id)) {%>
        <div class="card-body">
          <a class="btn btn-dark" href="/listings/<%=selectedListing._id %>/edit">Edit Listing</a>
          <br><br>   
          <form method="post" action="/listings/<%=selectedListing._id%>?_method=DELETE">
            <button class="btn btn-dark">Delete this listing</button>
          </form>
        </div>
        <%}%>
        <%}%>
        
        

      </div> </div> <hr class="col-8 offset-2 my-4">
      
  <% if(currUser) {%>
      <div class="col-8 offset-2 mb-3">
      <h4>Leave a Review</h4>
      
      <form action="/listings/<%=selectedListing._id%>/reviews" method="post" novalidate class="needs-validation">
        <!-- <div class="mb-3 mt-3">
          
          <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
        </div>
        <div class="mb-3 mt-3"> -->
           <label for="rating" class="form-label">Rating</label>
        <fieldset class="starability-growRotate">
        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
        <input type="radio" id="first-rate1" name="review[rating]" value="1" required />
        <label for="first-rate1" title="Terrible">1 star</label>
        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
        <label for="first-rate2" title="Not good">2 stars</label>
        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
        <label for="first-rate3" title="Average">3 stars</label>
        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
        <label for="first-rate4" title="Very good">4 stars</label>
        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
        <label for="first-rate5" title="Amazing">5 stars</label>
      </fieldset>

        <div class="mb-3 mt-3">
          <label class="form-label" for="comments">Comments</label>
          <textarea name="review[comment]" cols="30" rows="5" class="form-control" id="comments" required></textarea>
          <div class="invalid-feedback">Please add some comments for your review</div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
    </div>
  <%}else {%>
    
  <%}%>    
    <% if(selectedListing.reviews.length > 0) { %>
    <div class="col-8 offset-2">
      <p><b>All Reviews</b></p>
      <div class="row">
        <% for(review of selectedListing.reviews) { %>
          <div class="col-12 col-md-6 mb-3">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="card-title"><b>@ </b><%= review.writer.username %></h5>
                <p class="starability-result" data-rating="<%= review.rating %>">
                  Rated: <%= review.rating %> stars
                </p>
                <p class="card-text"><%= review.comment %></p>
                <%if(currUser){%>
                  <% if(currUser._id.equals(review.writer._id)) {%>
                <form class="mb-3" method="POST" action="/listings/<%= selectedListing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-dark">Delete</button>
                </form>
              <%}%>
              </div>
            </div>
          </div>
        <% } %>
        <% } %>

      </div>
      
    </div>
    <%}%>
    <hr/>
    <div class="col-8 offset-2 mb-3">
        <h3>Where you'll be</h3>
        <div id="map"></div>
      </div>
      

  </div> 
<script src="/javascript/map.js"></script>
</body>